{
  "rules": {
    ".read": false,
    ".write": false,
    "config": { ".read": true, ".write": "auth != null" },
    "categories": { ".read": true, ".write": "auth != null" },
    "products": { ".read": true, ".write": "auth != null" },
    "orders": {
      ".read": "auth != null",
      ".indexOn": ["createdAt", "status"],
      "$orderId": {
        ".write": "auth != null || (!data.exists() && newData.child('status').val() == 'new' && newData.child('total').val() != null)"
      }
    },
    "stats": { ".read": "auth != null", ".write": true },
    "aiScans": { ".read": "auth != null", ".write": true }
  }
}
